{
  "version": 1,
  "author": "SmartClass IoT Team",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 10, "left": 10, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht1", "top": -140, "left": -120, "attrs": { "temperature": "28", "humidity": "60" } },
    { "type": "wokwi-photoresistor-sensor", "id": "ldr1", "top": -140, "left": 160, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot1", "top": 200, "left": -130, "attrs": { "label": "MQ-135 Air Quality" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    
    [ "dht1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "dht1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "dht1:SDA", "esp:15", "green", [ "v0" ] ],

    [ "ldr1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "ldr1:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "ldr1:AO", "esp:34", "gold", [ "v0" ] ],

    [ "pot1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "pot1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "pot1:SIG", "esp:35", "purple", [ "v0" ] ]
  ],
  "dependencies": {}
}
